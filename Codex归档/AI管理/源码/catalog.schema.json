{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Asset Catalog",
  "type": "object",
  "required": ["catalogVersion", "assets"],
  "properties": {
    "catalogVersion": { "const": 1 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "owner", "source", "dependencies", "lifecycle"],
        "properties": {
          "id": { "type": "string", "pattern": "^(skill|cli|agent)/[a-z0-9][a-z0-9._-]*$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "owner": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "source": {
            "type": "object",
            "required": ["type", "location"],
            "properties": {
              "type": { "enum": ["git", "npm", "pypi", "winget", "scoop", "internal"] },
              "location": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "version", "required"],
              "properties": {
                "id": { "type": "string", "pattern": "^(skill|cli|agent)/" },
                "version": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "compatibility": {
            "type": "object",
            "properties": {
              "os": { "type": "array", "items": { "enum": ["windows", "linux", "macos"] } },
              "runtime": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          },
          "lifecycle": { "enum": ["active", "deprecated", "retired"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
