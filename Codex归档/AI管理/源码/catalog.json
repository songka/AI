{
  "$schema": "./catalog.schema.json",
  "catalogVersion": 1,
  "assets": [
    {
      "id": "skill/ai-assets-manager",
      "version": "1.0.6",
      "owner": "AI Platform Team",
      "description": "统一管理 Skill、CLI、Agent，包含登录门控、角色提示、自动草稿 Git 双备份和自更新。",
      "source": {
        "type": "internal",
        "location": "AI-Assets/artifacts/skill/ai-assets-manager"
      },
      "dependencies": [],
      "compatibility": {
        "os": ["windows"],
        "runtime": ["python>=3.11", "git"]
      },
      "lifecycle": "active"
    },
    {
      "id": "cli/codex",
      "version": "1.3.0",
      "owner": "AI Platform Team",
      "description": "团队批准使用的 Codex CLI。",
      "source": {
        "type": "npm",
        "location": "@openai/codex"
      },
      "dependencies": [],
      "compatibility": {
        "os": ["windows", "linux", "macos"],
        "runtime": ["node>=20"]
      },
      "lifecycle": "active"
    },
    {
      "id": "skill/code-review",
      "version": "1.1.0",
      "owner": "Developer Experience Team",
      "description": "统一代码评审流程和输出格式。",
      "source": {
        "type": "git",
        "location": "https://example.invalid/ai-assets/code-review-skill.git"
      },
      "dependencies": [
        {
          "id": "cli/codex",
          "version": ">=1.3.0 <2.0.0",
          "required": true
        }
      ],
      "compatibility": {
        "os": ["windows", "linux", "macos"],
        "runtime": []
      },
      "lifecycle": "active"
    },
    {
      "id": "skill/release-note",
      "version": "2.0.1",
      "owner": "Developer Experience Team",
      "description": "基于评审结果生成发布说明。",
      "source": {
        "type": "git",
        "location": "https://example.invalid/ai-assets/release-note-skill.git"
      },
      "dependencies": [
        {
          "id": "skill/code-review",
          "version": "^1.0.0",
          "required": true
        },
        {
          "id": "cli/codex",
          "version": "^1.3.0",
          "required": true
        }
      ],
      "compatibility": {
        "os": ["windows", "linux", "macos"],
        "runtime": []
      },
      "lifecycle": "active"
    }
  ]
}
